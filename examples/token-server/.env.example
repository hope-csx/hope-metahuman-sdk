# Copy to .env and fill in. Never commit the result.
#
# The API key secret belongs here, in your server's environment, and nowhere
# else. It does not expire: anything that reaches a browser with it grants
# permanent access to your tenant.

# Origin of your HOPE Metahuman Service deployment.
HOPE_API_BASE=https://api.hope-metahuman.example

# API key credentials, created in your tenant's portal.
HOPE_CLIENT_ID=mhs_...
HOPE_CLIENT_SECRET=

# Port this example listens on.
PORT=4173
