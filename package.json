{
  "name": "hope-metahuman-sdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source examples and documentation for the HOPE Metahuman Service SDK",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "clean": "rm -rf examples/static-chat/vendor",
    "example": "node scripts/serve-example.mjs",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md,html,css}\"",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-example.mjs",
    "typecheck:react-native": "npm --prefix examples/react-native run typecheck",
    "vendor": "node scripts/vendor-sdk.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cornerstonex/hope-metahuman-sdk.git"
  },
  "homepage": "https://github.com/cornerstonex/hope-metahuman-sdk#readme",
  "bugs": "https://github.com/cornerstonex/hope-metahuman-sdk/issues",
  "keywords": [
    "hope-metahuman",
    "metahuman",
    "avatar",
    "audio2face",
    "lipsync",
    "speech-to-text",
    "text-to-speech",
    "conversational-ai"
  ]
}
